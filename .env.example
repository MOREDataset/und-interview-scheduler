# Copy this file to ".env" and fill in real values. Never commit .env.

# --- Database -------------------------------------------------------------
# Local single-computer use (default): a SQLite file in ./data
# DATABASE_URL=sqlite:///data/scheduler.db
# Shared deployment: PostgreSQL
# DATABASE_URL=postgresql+psycopg://scheduler_user:CHANGE_ME@db-host:5432/scheduler

# --- App ------------------------------------------------------------------
APP_TIMEZONE=America/Chicago
# Address people use to reach the app (used to build faculty / candidate links)
APP_BASE_URL=http://localhost:8501
# Long random string used to sign the "stay signed in" cookie.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
# true = load fictional demo data when the database is empty
DEMO_MODE=true
DEMO_COORDINATOR_PASSWORD=demo-coordinator

# --- Branding -------------------------------------------------------------
ORG_NAME=University of North Dakota
UNIT_NAME=Department of Communication
# Logos are normally uploaded in the app (Search settings -> Logo).
# Optional fallback for PDFs: path to an AUTHORIZED logo PNG
# BRAND_LOGO_PATH=assets/und-logo.png

# --- Email (optional; without it the app prepares messages for you to send) --
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=communication-search@example.edu
# SMTP_STARTTLS=true
