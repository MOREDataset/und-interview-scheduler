# Optional university single sign-on (OpenID Connect) via Streamlit's st.login.
# Copy to .streamlit/secrets.toml and fill in values from your identity team.
# Only works if UND IT provides an OIDC client for this app. Signed-in emails
# must match a coordinator account created in the app.
[auth]
redirect_uri = "https://scheduler.example.edu/oauth2callback"
cookie_secret = "CHANGE_ME_long_random_string"
client_id = "CHANGE_ME"
client_secret = "CHANGE_ME"
server_metadata_url = "https://login.example.edu/.well-known/openid-configuration"
